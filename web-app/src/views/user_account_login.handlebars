<div class="auth-layout">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div>
                    <h1>{{{form_h1}}}</h1>
                    <p>{{{form_p}}}</p>
                </div>

                {{#if error_message}}
                    {{#ifNotEquals error_message ""}}
                    <div class="alert alert-danger" role="alert">
                        <p>{{error_message}}</p>
                        <p>Login failed, please try again!</p>
                        {{!-- <p>Login Failed! (Remember to login with your username - not your email address)</p> --}}
                    </div>
                    {{/ifNotEquals}}
                {{/if}}

                <div class="row">
                    <div class="col-md-6">
                        <form method="post" action="/account/login" class="modern-form">
                            <div class="form-group">
                                <label for="email" class="form-label">Email:</label>
                                <input type="email" id="email" name="email" placeholder="Email address" required class="form-control">
                            </div>
                            
                            <div class="form-group">
                                <label for="password" class="form-label">Password:</label>
                                <input type="password" id="password" name="password" placeholder="Password" required class="form-control">
                            </div>
                            
                            <div class="form-group">
                                <button type="submit" class="btn btn-secondary w-100">Sign In</button>
                            </div>
                        </form>

                        <div class="form-group">
                            <a href="/account/login/google" class="btn google-btn w-100">
                                <img src="https://img.icons8.com/color/16/000000/google-logo.png" alt="Google"/> 
                                Login with Google
                            </a>
                        </div>
                        
                        <hr>
                        <p class="cookie-notice">The admin section of the website uses functional cookies.</p>
                        <p><a href="/account/register">Register New Account</a> | <a href="/account/reset-password">Forgot Password?</a></p>
                    </div>
                    
                    <div class="col-md-6">
                        <h2>Cloud ViPER</h2>
                        <p>Welcome to our app! Here, we prioritize your privacy and security above all. Feel free to log in and explore our features. Remember, we never share your information with anyone.</p>
                        <p>If you encounter any issues while logging in, please contact our support team for assistance. We're here to help you every step of the way.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>