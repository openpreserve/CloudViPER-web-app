<div class="auth-layout">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div>
                    <h1>{{{form_h1}}}</h1>
                    <p>{{{form_p}}}</p>
                </div>

                {{#if error_message}}
                    {{#ifNotEquals error_message ""}}
                    <div class="alert alert-danger" role="alert">
                        <p>There was an error!</p>
                        <p>{{error_message}}</p>
                    </div>
                    {{/ifNotEquals}}
                {{/if}}

                <div class="row">
                    <div class="col-md-6">
                        <form method="post" action="/account/reset-password" class="modern-form">
                            <div class="form-group">
                                <label for="email" class="form-label">Email Address:</label>
                                <input type="email" id="email" name="email" placeholder="Enter your email address" required class="form-control">
                            </div>
                            
                            <div class="form-group">
                                <button type="submit" class="btn btn-secondary w-100">Send Reset Link</button>
                            </div>
                        </form>

                        <p class="cookie-notice">The admin section of the website uses functional cookies.</p>
                    </div>
                    
                    <div class="col-md-6">
                        <h2>Password Reset</h2>
                        <p>Please enter your email address, and we will email further instructions for resetting the password for this account.</p>
                        <p><a href="/account/login">Back to Login</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>