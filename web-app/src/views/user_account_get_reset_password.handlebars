<div class="cloud-page">
    <!-- Password Reset Cloud -->
    <div class="login-cloud">
        <h1>{{{form_h1}}}</h1>
        <p>{{{form_p}}}</p>

        {{#if error_message}}
            {{#ifNotEquals error_message ""}}
            <div class="error-alert">
                <p>There was an error!</p>
                <p>{{error_message}}</p>
            </div>
            {{/ifNotEquals}}
        {{/if}}

        <div class="login-content">
            <div class="login-form">
                <form method="post" action="/account/reset-password">
                    <label for="email">Email Address:</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email address" required>
                    
                    <button type="submit">Send Reset Link</button>
                </form>

                <p class="cookie-notice">The admin section of the website uses functional cookies.</p>
            </div>
            
            <div class="welcome-text">
                <h2>Password Reset</h2>
                <p>Please enter your email address, and we will email further instructions for resetting the password for this account.</p>
                <p class="login-links"><a href="/account/login">Back to Login</a></p>
            </div>
        </div>
    </div>

    <!-- Information Section -->
    <div class="info-section">
        <div class="info-column">
            <h3><i class="fas fa-envelope" style="color: #87CEEB;"></i> Password Recovery</h3>
            <p>Enter your email address and we'll send you a secure link to reset your password. The reset link will expire after 24 hours for security purposes.</p>
        </div>
        <div class="info-column">
            <h3><i class="fas fa-shield-alt" style="color: #137DA4;"></i> Account Security</h3>
            <p>Your account security is our priority. All password reset requests are logged and monitored. If you didn't request this reset, please contact our support team immediately.</p>
        </div>
        <div class="info-column">
            <h3><i class="fas fa-question-circle" style="color: #20B2AA;"></i> Need Help?</h3>
            <p>Having trouble accessing your account? Our support team is here to help. Contact us for assistance with account recovery, technical issues, or any other questions.</p>
        </div>
    </div>
</div>