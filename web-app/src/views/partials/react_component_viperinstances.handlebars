class ViPERInstanceList extends React.Component {
      constructor(props) {
        super(props);
        this.state = {
          instances: [],
          isLoading: true,
          error: null,
          selectedInstance: null,
          instanceDetails: null,
          detailsLoading: false,
          // Filter state
          filters: {
            active: true,
            inactive: true,
            building: true,
            created: true,
            deleted: true,
            error: true,
            pending: true
          },
          showFilters: false
        };
      }

      componentDidMount() {
        this.fetchInstances();
        this.interval = setInterval(this.fetchInstances, 6000); // 10 seconds interval
      }

      componentWillUnmount() {
        clearInterval(this.interval);
      }

      fetchInstances = () => {
        fetch('/service/viperinstances')
          .then(response => response.json())
          .then(data => {
            // Handle the new API response format
            let instances = [];
            if (data && Array.isArray(data.instances)) {
              instances = data.instances;
            } else if (Array.isArray(data)) {
              // Fallback for old format
              instances = data;
            }
            console.log('Fetched instances:', instances); // Debug log
            this.setState({ instances: instances, isLoading: false });
          })
          .catch(error => {
            console.error('Error fetching instances:', error);
            this.setState({ error, isLoading: false, instances: [] });
          });
      }

      startNewInstance = () => {
        fetch('/service/new-instance', { method: 'GET' })
          .then(response => {
            if (response.ok) {
              this.fetchInstances();
            }
          })
          .catch(error => console.error('Error starting new instance:', error));
      }

      removeInstance = (dockerid) => {
        fetch('/service/terminate-instance/' + dockerid, { method: 'GET' })
          .then(response => {
            if (response.ok) {
              this.setState(prevState => ({
                instances: prevState.instances.filter(instance => instance.dockerid !== dockerid)
              }));
            }
          })
          .catch(error => console.error('Error terminating instance:', error));
      }

      formatOwnerInfo = (instance) => {
        if (!instance) {
          return 'Unknown';
        }
        
        if (instance.ownerUser) {
          const user = instance.ownerUser;
          // Prefer firstName + lastName, then username, then email
          if (user.firstName && user.lastName) {
            return `${user.firstName} ${user.lastName} (${user.email})`;
          } else if (user.username) {
            return `${user.username} (${user.email})`;
          } else {
            return user.email;
          }
        }
        // Fallback to owner ID if user data is not available
        return 'User ID: ' + (instance.owner || 'Unknown');
      }

      showInstanceDetails = async (instance) => {
        this.setState({ detailsLoading: true, selectedInstance: instance });
        
        try {
          const response = await fetch(`/service/viperinstance/${instance.dockerid}/inspect`);
          if (response.ok) {
            const details = await response.json();
            this.setState({ instanceDetails: details, detailsLoading: false });
          } else {
            console.error('Failed to fetch instance details');
            this.setState({ 
              instanceDetails: { 
                error: 'Failed to fetch details',
                instance: instance,
                operationalHours: 'Unknown',
                dockerInspect: { error: 'API request failed', message: 'Could not fetch Docker details' }
              }, 
              detailsLoading: false 
            });
          }
        } catch (error) {
          console.error('Error fetching instance details:', error);
          this.setState({ 
            instanceDetails: { 
              error: 'Error fetching details',
              instance: instance,
              operationalHours: 'Unknown',
              dockerInspect: { error: 'Network error', message: error.message || 'Unknown error occurred' }
            }, 
            detailsLoading: false 
          });
        }
      }

      closeDetailsPanel = () => {
        this.setState({ selectedInstance: null, instanceDetails: null });
      }

      formatBytes = (bytes) => {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
      }

      isAdmin = () => {
        // Check if current user is admin - we'll get this from props
        return this.props.userRole === 'admin';
      }

      // Filter methods
      toggleFilter = (status) => {
        this.setState(prevState => ({
          filters: {
            ...prevState.filters,
            [status]: !prevState.filters[status]
          }
        }));
      }

      toggleFiltersPanel = () => {
        this.setState(prevState => ({
          showFilters: !prevState.showFilters
        }));
      }

      getFilteredInstances = () => {
        const { instances, filters } = this.state;
        if (!Array.isArray(instances)) return [];
        
        return instances.filter(instance => {
          const status = instance.status || 'unknown';
          return filters[status] !== false;
        });
      }

      selectAllFilters = () => {
        this.setState({
          filters: {
            active: true,
            inactive: true,
            building: true,
            created: true,
            deleted: true,
            error: true,
            pending: true
          }
        });
      }

      clearAllFilters = () => {
        this.setState({
          filters: {
            active: false,
            inactive: false,
            building: false,
            created: false,
            deleted: false,
            error: false,
            pending: false
          }
        });
      }

      formatUrl = (url) => {
        return 'https://' + url;
      }

      loadActivityHistory = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/activity/${instanceUUID}`);
          const data = await response.json();
          
          if (data.success) {
            alert(`Activity Summary for ${instanceUUID}:
Total Events: ${data.summary.totalEvents}
Average CPU: ${data.summary.avgCpuUsage}%
Average Memory: ${data.summary.avgMemoryUsage}%
Last Activity: ${data.summary.lastActivity ? new Date(data.summary.lastActivity).toLocaleString() : 'Never'}
User Active: ${data.summary.isUserActive ? 'Yes' : 'No'}
Activity Score: ${data.summary.currentScore}`);
          } else {
            console.error('Error loading activity:', data.error);
            alert('Error loading activity history: ' + data.error);
          }
        } catch (error) {
          console.error('Error fetching activity:', error);
          alert('Error fetching activity history');
        }
      }

      viewScreenshot = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/screenshot/${instanceUUID}`);
          const data = await response.json();
          
          if (data.success && data.screenshot) {
            // Create a modal or new window to display the screenshot
            const screenshotWindow = window.open('', '_blank', 'width=800,height=600');
            screenshotWindow.document.write(`
              <html>
                <head><title>Screenshot - ${instanceUUID}</title></head>
                <body style="margin:0;padding:20px;background:#f0f0f0;">
                  <h3>Instance Screenshot</h3>
                  <p><strong>Instance:</strong> ${instanceUUID}</p>
                  <p><strong>Captured:</strong> ${data.screenshot.capturedAt ? new Date(data.screenshot.capturedAt).toLocaleString() : 'Unknown'}</p>
                  <img src="data:image/png;base64,${data.screenshot.screenshot}" style="max-width:100%;border:1px solid #ccc;" />
                </body>
              </html>
            `);
          } else {
            alert('No screenshot available for this instance');
          }
        } catch (error) {
          console.error('Error fetching screenshot:', error);
          alert('Error fetching screenshot');
        }
      }

      cleanupInactiveInstances = async () => {
        if (!confirm('This will automatically shutdown instances that have been inactive for 30+ minutes. Continue?')) {
          return;
        }

        try {
          const response = await fetch('/service/cleanup-inactive', { method: 'POST' });
          const data = await response.json();
          
          if (data.success) {
            alert(`Cleanup completed: ${data.shutdownCount} instances shut down`);
            this.fetchInstances(); // Refresh the list
          } else {
            alert('Error during cleanup: ' + data.error);
          }
        } catch (error) {
          console.error('Error during cleanup:', error);
          alert('Error during cleanup');
        }
      }

      render() {
        const { instances, isLoading, error, selectedInstance, instanceDetails, detailsLoading, filters, showFilters } = this.state;
        const filteredInstances = this.getFilteredInstances();

        if (isLoading) {
          return <p>Loading instances...</p>;
        }

        if (error) {
          return <p>Error loading instances: {error.message}</p>;
        }

        return (
          <div>
            <h1>ViPER Instances</h1>
            
            {/* Filter Controls */}
            <div className="filter-controls mb-3">
              <button 
                className="btn btn-outline-secondary btn-sm" 
                onClick={this.toggleFiltersPanel}
              >
                <i className="fas fa-filter"></i> {showFilters ? 'Hide' : 'Show'} Filters
              </button>
              
              {showFilters && (
                <div className="filter-panel mt-2 p-3 border rounded bg-light">
                  <div className="row">
                    <div className="col-md-8">
                      <h6>Filter by Instance Status:</h6>
                      <div className="filter-checkboxes">
                        {Object.entries(filters).map(([status, checked]) => (
                          <label key={status} className="filter-checkbox">
                            <input
                              type="checkbox"
                              checked={checked}
                              onChange={() => this.toggleFilter(status)}
                            />
                            <span className={'status-badge status-' + status + ' ml-1'}>
                              {status.charAt(0).toUpperCase() + status.slice(1)}
                            </span>
                          </label>
                        ))}
                      </div>
                    </div>
                    <div className="col-md-4">
                      <h6>Quick Actions:</h6>
                      <button 
                        className="btn btn-sm btn-success mr-2" 
                        onClick={this.selectAllFilters}
                      >
                        Select All
                      </button>
                      <button 
                        className="btn btn-sm btn-danger" 
                        onClick={this.clearAllFilters}
                      >
                        Clear All
                      </button>
                      <div className="mt-2">
                        <small className="text-muted">
                          Showing {filteredInstances.length} of {instances.length} instances
                        </small>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>

            <div className="btn-container">
              <button className="btn btn-primary" onClick={this.startNewInstance}>Start New Instance</button>
            </div>

            {/* Instance Details Modal */}
            {selectedInstance && (
              <div className="instance-details-overlay" onClick={this.closeDetailsPanel}>
                <div className="instance-details-modal" onClick={(e) => e.stopPropagation()}>
                  <div className="modal-header">
                    <h3>Instance Details: {selectedInstance.name}</h3>
                    <button className="btn btn-sm btn-secondary" onClick={this.closeDetailsPanel}>
                      <i className="fas fa-times"></i>
                    </button>
                  </div>
                  
                  {detailsLoading ? (
                    <div className="modal-body">
                      <p>Loading detailed information...</p>
                    </div>
                  ) : instanceDetails ? (
                    <div className="modal-body">
                      {instanceDetails.error ? (
                        <div className="error-message">
                          <p><strong>Error:</strong> {instanceDetails.error}</p>
                          <p>Showing basic instance information only.</p>
                        </div>
                      ) : null}
                      
                      {/* Human-readable metadata */}
                      <div className="details-section">
                        <h4><i class="fas fa-chart-line"></i> Instance Metadata</h4>
                        <div className="metadata-grid">
                          <div><strong>Operational Time:</strong> {instanceDetails.operationalHours || 'Unknown'} hours</div>
                          <div><strong>Owner:</strong> {this.formatOwnerInfo(instanceDetails.instance)}</div>
                          <div><strong>Status:</strong> 
                            {instanceDetails.instance && instanceDetails.instance.status ? (
                              <span className={'status-badge status-' + instanceDetails.instance.status}>
                                {instanceDetails.instance.status}
                              </span>
                            ) : (
                              'Unknown'
                            )}
                          </div>
                          <div><strong>Docker ID:</strong> <code>{instanceDetails.instance && instanceDetails.instance.dockerid || 'Unknown'}</code></div>
                          <div><strong>UUID:</strong> <code>{instanceDetails.instance && instanceDetails.instance.uuid || 'Unknown'}</code></div>
                          <div><strong>Created:</strong> 
                            {instanceDetails.instance && instanceDetails.instance.createdAt ? 
                              new Date(instanceDetails.instance.createdAt).toLocaleString() : 
                              'Unknown'
                            }
                          </div>
                          <div><strong>VNC Password:</strong> <code>{instanceDetails.instance && instanceDetails.instance.kasmvncPassword || 'Unknown'}</code></div>
                          <div><strong>URL:</strong> 
                            {instanceDetails.instance && instanceDetails.instance.url ? (
                              instanceDetails.instance.status === 'active' ? (
                                <a href={this.formatUrl(instanceDetails.instance.url)} target="_blank" rel="noopener noreferrer">
                                  {instanceDetails.instance.url}
                                </a>
                              ) : (
                                instanceDetails.instance.url
                              )
                            ) : (
                              'Unknown'
                            )}
                          </div>
                        </div>
                      </div>

                      {/* Docker Inspect Data */}
                      <div className="details-section">
                        <h4>🐳 Docker Inspect Data</h4>
                        {instanceDetails.dockerInspect && instanceDetails.dockerInspect.error ? (
                          <div className="error-message">
                            <p><strong>Error:</strong> {instanceDetails.dockerInspect.error}</p>
                            <p>{instanceDetails.dockerInspect.message}</p>
                          </div>
                        ) : instanceDetails.dockerInspect ? (
                          <div className="docker-inspect-container">
                            <pre className="docker-inspect-json">
                              {JSON.stringify(instanceDetails.dockerInspect, null, 2)}
                            </pre>
                          </div>
                        ) : (
                          <div className="error-message">
                            <p><strong>No Docker data available</strong></p>
                            <p>Docker inspect information could not be retrieved.</p>
                          </div>
                        )}
                      </div>
                    </div>
                  ) : (
                    <div className="modal-body">
                      <p>Error loading instance details.</p>
                    </div>
                  )}
                </div>
              </div>
            )}

            <table className="table table-striped">
              <thead>
                <tr>
                    <th>ViPERs:</th>
                </tr>
              </thead>
              <tbody>
                {Array.isArray(filteredInstances) && filteredInstances.map(instance => (
                  <tr key={instance.uuid}><td>

                        {{!-- <row> --}}
                        <div className="card mb-3">
                        <div className="row">
                            <div className="col-md-4 center-image">
                            <img src="/images/apple-icon-180x180.png" className="card-img-custom" alt="Placeholder" />
                            </div>
                            <div className="col-md-8">
                            <div className="card-body">
                                <h5 className="card-title">{instance.name}</h5>
                                <h6 className="card-subtitle mb-2 text-muted">{instance.dockerid}</h6>
                                <p className="card-text">
                                <small className="text-muted">
                                  <span className={'status-badge status-' + instance.status}>
                                    {instance.status}
                                  </span>
                                </small><br/>
                                <small className="text-muted"><strong>UUID: </strong>{instance.uuid}</small><br/>
                  <small className="text-muted">
                    <strong>URL: </strong>
                    {instance.status === 'active' ? (
                      <a href={this.formatUrl(instance.url)} target="_blank" rel="noopener noreferrer">{instance.url}</a>
                    ) : (
                      instance.url
                    )}
                  </small><br/>
                                <small className="text-muted"><strong>Username: </strong>abc</small><br/>
                                <small className="text-muted"><strong>Password: </strong>{instance.kasmvncPassword}</small><br/>
                                <small className="text-muted"><strong>Created At: </strong>{new Date(instance.createdAt).toLocaleString()}</small><br/>
                                <small className="text-muted"><strong>Owner: </strong>{this.formatOwnerInfo(instance)}</small><br/>
                                {instance.lastActivity && (
                                  <small className="text-muted"><strong>Last Activity: </strong>{new Date(instance.lastActivity).toLocaleString()}</small>
                                )}<br/>
                                {instance.isUserActive !== undefined && (
                                  <small className="text-muted">
                                    <strong>Status: </strong>
                                    <span className={instance.isUserActive ? 'text-success' : 'text-warning'}>
                                      {instance.isUserActive ? '🟢 Active User' : '🟡 Inactive'}
                                    </span>
                                  </small>
                                )}<br/>
                                {instance.activityScore !== undefined && (
                                  <small className="text-muted"><strong>Activity Score: </strong>{instance.activityScore}</small>
                                )}
                                </p>
                
                <div className="instance-buttons">
                  <button
                    className={'btn btn-primary ' + (instance.status === 'active' ? '' : 'disabled')} 
                    onClick={() => window.open(this.formatUrl(instance.url), '_blank')}
                    disabled={instance.status !== 'active'}
                  >
                    <i className="fas fa-external-link-alt"></i> Launch Instance
                  </button>
                  {this.isAdmin() && (
                    <button 
                      className="btn btn-info" 
                      onClick={() => this.showInstanceDetails(instance)}
                    >
                      <i className="fas fa-info-circle"></i> Details
                    </button>
                  )}
                  {this.isAdmin() && (
                    <button 
                      className="btn btn-success btn-sm" 
                      onClick={() => this.loadActivityHistory(instance.uuid)}
                    >
                      <i className="fas fa-chart-line"></i> Activity
                    </button>
                  )}
                  {this.isAdmin() && instance.lastScreenshot && (
                    <button 
                      className="btn btn-secondary btn-sm" 
                      onClick={() => this.viewScreenshot(instance.uuid)}
                    >
                      <i className="fas fa-camera"></i> Screenshot
                    </button>
                  )}
                  <button 
                    className={'btn btn-danger ' + (instance.status === 'deleted' ? 'disabled' : '')} 
                    onClick={() => this.removeInstance(instance.dockerid)} 
                    disabled={instance.status === 'deleted'}
                  >
                    <i className="fas fa-trash"></i> Remove Instance
                  </button>
                </div>
                            </div>
                            </div>
                        </div>
                        </div>
                    {{!-- </row> --}}

                  </td></tr>
                ))}
              </tbody>
            </table>

            {/* Admin Cleanup Controls */}
            {this.isAdmin() && (
              <div className="alert alert-warning mt-4">
                <h5><i className="fas fa-tools"></i> Admin Controls</h5>
                <p>Use these controls to manage inactive instances automatically.</p>
                <button 
                  className="btn btn-warning"
                  onClick={this.cleanupInactiveInstances}
                >
                  <i className="fas fa-broom"></i> Cleanup Inactive Instances
                </button>
                <small className="form-text text-muted mt-2">
                  This will automatically shutdown instances that have been inactive for 30+ minutes.
                </small>
              </div>
            )}
          </div>
        );
      }
    }