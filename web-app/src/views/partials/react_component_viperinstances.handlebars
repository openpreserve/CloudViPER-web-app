    /* Activity Chart Styles */
    const chartStyles = `
      .activity-chart-container {
        text-align: center;
        padding: 10px;
        background: #eaf6fb;
        border-radius: 8px;
        margin: 5px;
      }
      .chart-title {
        color: #495057;
        margin-bottom: 8px;
        font-weight: 600;
      }
      .chart-legend {
        display: flex;
        justify-content: space-around;
        margin-top: 5px;
      }
      .instance-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        justify-content: center;
      }
      .instance-buttons .btn {
        margin: 2px;
      }
      .card-footer {
        background-color: #f8f9fa;
        border-top: 1px solid #dee2e6;
        padding: 10px;
      }
      
      /* Screenshot Carousel Styles */
      .screenshot-container {
        position: relative;
        width: 100%;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      
      .screenshot-container.loading {
        background: #f8f9fa;
      }
      
      .loading-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 5px;
        font-size: 10px;
        text-align: center;
      }
      
      .carousel-container {
        border: 2px solid #dee2e6;
        transition: border-color 0.3s ease;
      }
      
      .carousel-container:hover {
        border-color: #007bff;
      }
      
      .screenshot-wrapper {
        position: relative;
        width: 100%;
        height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
      }
      
      .screenshot-image {
        max-width: 100%;
        max-height: 100%;
        height: 100%;
        width: auto;
        object-fit: contain;
        cursor: pointer;
      }
      
      .screenshot-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8f9fa;
        padding: 8px 10px;
        border-top: 1px solid #dee2e6;
      }
      
      .screenshot-nav {
        display: flex;
        gap: 8px;
        align-items: center;
      }
      
      .carousel-btn {
        background: #007bff;
        color: white;
        border: none;
        width: 28px;
        height: 28px;
        border-radius: 4px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
      }
      
      .carousel-btn:hover {
        background: #0056b3;
        transform: scale(1.05);
      }
      
      .carousel-btn:disabled {
        background: #6c757d;
        cursor: not-allowed;
        opacity: 0.5;
      }
      
      .screenshot-info {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
      }
      
      .screenshot-counter {
        background: #007bff;
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: bold;
      }
      
      .screenshot-badge {
        background: #28a745;
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 10px;
      }
      
      .screenshot-timestamp {
        font-size: 10px;
        color: #6c757d;
        font-style: italic;
      }
      
      /* Screenshot Modal Styles */
      .screenshot-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 20px;
      }
      
      .screenshot-modal-content {
        position: relative;
        max-width: 95vw;
        max-height: 95vh;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
      }
      
      .screenshot-modal-header {
        padding: 15px 20px;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      
      .modal-title {
        margin: 0;
        font-size: 16px;
      }
      
      .screenshot-modal-body {
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        max-height: calc(95vh - 80px);
      }
      
      .screenshot-modal-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }
      
      .screenshot-modal-close {
        background: none;
        border: none;
        font-size: 24px;
        color: #6c757d;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .screenshot-modal-close:hover {
        color: #000;
      }
    `;
    
    // Inject styles
    if (!document.getElementById('activity-chart-styles')) {
      const styleSheet = document.createElement('style');
      styleSheet.id = 'activity-chart-styles';
      styleSheet.textContent = chartStyles;
      document.head.appendChild(styleSheet);
    }

    class ViPERInstanceList extends React.Component {
      constructor(props) {
        super(props);
        this.state = {
          instances: [],
          isLoading: true,
          error: null,
          selectedInstance: null,
          instanceDetails: null,
          detailsLoading: false,
          // Filter state
          filters: {
            creating: true,
            initializing: true,
            ready: true,
            error: true,
            deleted: false  // Hide deleted by default
          },
          showFilters: false,
          // Screenshot carousel state
          screenshotCarousels: {}, // Store carousel data for each instance
          // Screenshot modal state
          screenshotModal: {
            isOpen: false,
            imageUrl: '',
            instanceUUID: '',
            screenshotIndex: 0,
            title: ''
          },
          // Activity chart state - track which charts are initialized
          initializedCharts: {}, // { uuid: boolean }
          // Loading states for buttons
          creatingInstance: false,
          deletingInstances: {}, // { podName: boolean }
          // Connection status
          connectionLost: false,
          connectionRestored: false,
          lastSuccessfulFetch: new Date()
        };
      }

      componentDidMount() {
        this.fetchInstances();
        this.interval = setInterval(this.fetchInstances, 6000); // 10 seconds interval
      }

      componentWillUnmount() {
        clearInterval(this.interval);
      }

      fetchInstances = async () => {
        try {
          const response = await fetch('/service/viperinstances');
          
          // Check if response is OK (status 200-299)
          if (!response.ok) {
            // If service unavailable (503) or other server error, keep existing data and show banner
            if (response.status === 503 || response.status >= 500) {
              console.warn('Service temporarily unavailable, keeping existing data...');
              const hadConnection = !this.state.connectionLost;
              this.setState({ 
                connectionLost: true,
                connectionRestored: false,
                isLoading: false
              });
              
              // Auto-hide the banner after showing it was restored
              if (hadConnection) {
                // First time losing connection, schedule retry
                setTimeout(() => {
                  console.log('Retrying connection...');
                  this.fetchInstances();
                }, 10000); // Retry after 10 seconds
              }
              return;
            }
            throw new Error(`Server returned ${response.status}: ${response.statusText}`);
          }
          
          const data = await response.json();
          
          // Handle the new API response format
          let instances = [];
          if (data && Array.isArray(data.instances)) {
            instances = data.instances;
          } else if (Array.isArray(data)) {
            // Fallback for old format
            instances = data;
          }
          
          console.log('Fetched instances:', instances); // Debug log
          
          // Check if we just restored connection
          const wasDisconnected = this.state.connectionLost;
          
          this.setState({ 
            instances: instances, 
            isLoading: false, 
            error: null,
            connectionLost: false,
            connectionRestored: wasDisconnected, // Show green banner if we were disconnected
            lastSuccessfulFetch: new Date()
          }, () => {
            // Refresh charts and initialize screenshot carousels after state update
            this.refreshAllCharts();
            this.initializeAllScreenshotCarousels();
            
            // Auto-hide the "connection restored" banner after 5 seconds
            if (wasDisconnected) {
              setTimeout(() => {
                this.setState({ connectionRestored: false });
              }, 5000);
            }
          });
        } catch (error) {
          console.error('Error fetching instances:', error);
          
          // Keep existing data and show connection lost banner
          const hadConnection = !this.state.connectionLost;
          
          this.setState({ 
            connectionLost: true,
            connectionRestored: false,
            isLoading: false
          });
          
          // Schedule retry after 10 seconds
          if (hadConnection) {
            setTimeout(() => {
              console.log('Retrying connection after error...');
              this.fetchInstances();
            }, 10000);
          }
        }
      }

      // Initialize screenshot carousels for all instances
      initializeAllScreenshotCarousels = () => {
        const { instances } = this.state;
        instances.forEach(instance => {
          // Small delay to ensure DOM is ready
          setTimeout(() => this.initializeScreenshotCarousel(instance.uuid), 300);
        });
      }

      // Refresh all activity charts
      refreshAllCharts = () => {
        const { instances } = this.state;
        instances.forEach(instance => {
          const canvasId = `chart-${instance.uuid}`;
          // Small delay to ensure DOM is updated
          setTimeout(() => this.initializeChart(canvasId, instance.uuid), 200);
        });
      }

      // Screenshot carousel methods
      fetchScreenshotsForInstance = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/screenshots/${instanceUUID}`);
          const data = await response.json();
          
          if (data.success) {
            return {
              uniqueScreenshots: data.uniqueScreenshots || [],
              totalCount: data.totalScreenshots || 0,
              uniqueCount: data.uniqueCount || 0
            };
          }
          return { uniqueScreenshots: [], totalCount: 0, uniqueCount: 0 };
        } catch (error) {
          console.error('Error fetching screenshots:', error);
          return { uniqueScreenshots: [], totalCount: 0, uniqueCount: 0 };
        }
      }

      // Initialize screenshot carousel for an instance
      initializeScreenshotCarousel = async (instanceUUID) => {
        const screenshotData = await this.fetchScreenshotsForInstance(instanceUUID);
        
        this.setState(prevState => ({
          screenshotCarousels: {
            ...prevState.screenshotCarousels,
            [instanceUUID]: {
              screenshots: screenshotData.uniqueScreenshots,
              currentIndex: 0,
              totalCount: screenshotData.totalCount,
              uniqueCount: screenshotData.uniqueCount,
              hasScreenshots: screenshotData.uniqueScreenshots.length > 0
            }
          }
        }));
      }

      // Navigate carousel
      navigateScreenshot = (instanceUUID, direction) => {
        this.setState(prevState => {
          const carousel = prevState.screenshotCarousels[instanceUUID];
          if (!carousel || carousel.screenshots.length === 0) return prevState;

          let newIndex = carousel.currentIndex;
          if (direction === 'next') {
            newIndex = (newIndex + 1) % carousel.screenshots.length;
          } else if (direction === 'prev') {
            newIndex = newIndex === 0 ? carousel.screenshots.length - 1 : newIndex - 1;
          }

          return {
            screenshotCarousels: {
              ...prevState.screenshotCarousels,
              [instanceUUID]: {
                ...carousel,
                currentIndex: newIndex
              }
            }
          };
        });
      }

      // Screenshot modal methods
      openScreenshotModal = (instance, currentScreenshot) => {
        const screenshotSrc = `/service/screenshot-image/${instance.uuid}?index=${currentScreenshot && currentScreenshot.index ? currentScreenshot.index : 0}`;
        const title = `${instance.name} - Screenshot ${currentScreenshot && currentScreenshot.capturedAt ? new Date(currentScreenshot.capturedAt).toLocaleString() : 'Unknown'}`;
        
        this.setState({
          screenshotModal: {
            isOpen: true,
            imageUrl: screenshotSrc,
            instanceUUID: instance.uuid,
            screenshotIndex: currentScreenshot ? currentScreenshot.index : 0,
            title: title
          }
        });
      }

      closeScreenshotModal = () => {
        this.setState({
          screenshotModal: {
            isOpen: false,
            imageUrl: '',
            instanceUUID: '',
            screenshotIndex: 0,
            title: ''
          }
        });
      }

      startNewInstance = () => {
        this.setState({ creatingInstance: true });
        fetch('/service/new-instance', { method: 'GET' })
          .then(response => {
            if (response.ok) {
              // Wait a moment then refresh to see the new instance
              setTimeout(() => {
                this.fetchInstances();
                this.setState({ creatingInstance: false });
              }, 1000);
            } else {
              this.setState({ creatingInstance: false });
              alert('Error starting new instance');
            }
          })
          .catch(error => {
            console.error('Error starting new instance:', error);
            this.setState({ creatingInstance: false });
            alert('Error starting new instance: ' + error.message);
          });
      }

      removeInstance = (podName) => {
        if (!confirm('Are you sure you want to remove this instance?')) {
          return;
        }
        
        this.setState(prevState => ({
          deletingInstances: {
            ...prevState.deletingInstances,
            [podName]: true
          }
        }));
        
        fetch('/service/terminate-instance/' + podName, { method: 'GET' })
          .then(response => {
            if (response.ok) {
              // Remove from state after a short delay
              setTimeout(() => {
                this.setState(prevState => ({
                  instances: prevState.instances.filter(instance => instance.podName !== podName),
                  deletingInstances: {
                    ...prevState.deletingInstances,
                    [podName]: false
                  }
                }));
              }, 1000);
            } else {
              this.setState(prevState => ({
                deletingInstances: {
                  ...prevState.deletingInstances,
                  [podName]: false
                }
              }));
              alert('Error removing instance');
            }
          })
          .catch(error => {
            console.error('Error terminating instance:', error);
            this.setState(prevState => ({
              deletingInstances: {
                ...prevState.deletingInstances,
                [podName]: false
              }
            }));
            alert('Error removing instance: ' + error.message);
          });
      }

      formatOwnerInfo = (instance) => {
        if (!instance) {
          return 'Unknown';
        }
        
        if (instance.ownerUser) {
          const user = instance.ownerUser;
          // Prefer firstName + lastName, then username, then email
          if (user.firstName && user.lastName) {
            return `${user.firstName} ${user.lastName} (${user.email})`;
          } else if (user.username) {
            return `${user.username} (${user.email})`;
          } else {
            return user.email;
          }
        }
        // Fallback to owner ID if user data is not available
        return 'User ID: ' + (instance.owner || 'Unknown');
      }

      showInstanceDetails = async (instance) => {
        this.setState({ detailsLoading: true, selectedInstance: instance });
        
        try {
          const response = await fetch(`/service/viperinstance/${instance.podName}/inspect`);
          if (response.ok) {
            const details = await response.json();
            this.setState({ instanceDetails: details, detailsLoading: false });
          } else {
            console.error('Failed to fetch instance details');
            this.setState({ 
              instanceDetails: { 
                error: 'Failed to fetch details',
                instance: instance,
                operationalHours: 'Unknown',
                podInspect: { error: 'API request failed', message: 'Could not fetch pod details' }
              }, 
              detailsLoading: false 
            });
          }
        } catch (error) {
          console.error('Error fetching instance details:', error);
          this.setState({ 
            instanceDetails: { 
              error: 'Error fetching details',
              instance: instance,
              operationalHours: 'Unknown',
              podInspect: { error: 'Network error', message: error.message || 'Unknown error occurred' }
            }, 
            detailsLoading: false 
          });
        }
      }

      closeDetailsPanel = () => {
        this.setState({ selectedInstance: null, instanceDetails: null });
      }

      formatBytes = (bytes) => {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
      }

      isAdmin = () => {
        // Check if current user is admin - we'll get this from props
        return this.props.userRole === 'admin';
      }

      // Filter methods
      toggleFilter = (status) => {
        this.setState(prevState => ({
          filters: {
            ...prevState.filters,
            [status]: !prevState.filters[status]
          }
        }));
      }

      toggleFiltersPanel = () => {
        this.setState(prevState => ({
          showFilters: !prevState.showFilters
        }));
      }

      getFilteredInstances = () => {
        const { instances, filters } = this.state;
        if (!Array.isArray(instances)) return [];
        
        return instances.filter(instance => {
          const status = instance.status || 'unknown';
          return filters[status] !== false;
        });
      }

      selectAllFilters = () => {
        this.setState({
          filters: {
            creating: true,
            initializing: true,
            ready: true,
            error: true,
            deleted: true
          }
        });
      }

      clearAllFilters = () => {
        this.setState({
          filters: {
            creating: false,
            initializing: false,
            ready: false,
            error: false,
            deleted: false
          }
        });
      }

      formatUrl = (url) => {
        // If URL already starts with http:// or https://, return as-is
        if (url.startsWith('http://') || url.startsWith('https://')) {
          return url;
        }
        // Otherwise, add https:// prefix (for legacy subdomain URLs)
        return 'https://' + url;
      }

      loadActivityHistory = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/activity/${instanceUUID}`);
          const data = await response.json();
          
          if (data.success) {
            // Enhanced display with better formatting and null checking
            const avgCpu = data.summary.avgCpuUsage != null ? Number(data.summary.avgCpuUsage).toFixed(1) : 'N/A';
            const avgMemory = data.summary.avgMemoryUsage != null ? Number(data.summary.avgMemoryUsage).toFixed(1) : 'N/A';
            
            alert(`Activity Summary for ${instanceUUID}:
Total Events: ${data.summary.totalEvents || 0}
Average CPU Usage: ${avgCpu}%
Average Memory Usage: ${avgMemory}%
Last Activity: ${data.summary.lastActivity ? new Date(data.summary.lastActivity).toLocaleString() : 'Never'}
User Currently Active: ${data.summary.isUserActive ? 'Yes' : 'No'}
Current Activity Score: ${data.summary.currentScore || 0}`);
          } else {
            console.error('Error loading activity:', data.error);
            alert('Error loading activity history: ' + data.error);
          }
        } catch (error) {
          console.error('Error fetching activity:', error);
          alert('Error fetching activity history: ' + error.message);
        }
      }

      // Fetch activity data for charts (last 30 points)
      fetchActivityDataForChart = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/activity/${instanceUUID}?limit=30`);
          const data = await response.json();
          
          if (data.success && data.activityHistory) {
            return data.activityHistory.reverse(); // Reverse to show chronological order
          }
          return [];
        } catch (error) {
          console.error('Error fetching chart data:', error);
          return [];
        }
      }

      // Component for screenshot carousel
      renderScreenshotCarousel = (instance) => {
        const { screenshotCarousels } = this.state;
        const carousel = screenshotCarousels[instance.uuid];
        
        // Initialize carousel if not already done
        if (!carousel) {
          setTimeout(() => this.initializeScreenshotCarousel(instance.uuid), 100);
          return React.createElement('div', { className: 'screenshot-container loading' },
            React.createElement('img', { 
              src: '/images/CloudViPER-Logo.png',
              className: 'card-img-custom',
              alt: 'Loading...',
              style: { opacity: 0.7 }
            }),
            React.createElement('div', { className: 'loading-overlay' }, 'Loading screenshots...')
          );
        }

        // If no screenshots available, show default logo
        if (!carousel.hasScreenshots) {
          return React.createElement('div', { className: 'screenshot-container' },
            React.createElement('img', { 
              src: '/images/CloudViPER-Logo.png',
              className: 'card-img-custom',
              alt: 'ViPER Instance',
              title: 'No screenshots available'
            })
          );
        }

        // Show screenshot carousel
        const currentScreenshot = carousel.screenshots[carousel.currentIndex];
        const screenshotSrc = `/service/screenshot-image/${instance.uuid}?index=${currentScreenshot && currentScreenshot.index ? currentScreenshot.index : 0}`;
        const timestamp = currentScreenshot && currentScreenshot.capturedAt ? new Date(currentScreenshot.capturedAt).toLocaleString() : 'Unknown';
        
        return React.createElement('div', { className: 'screenshot-container carousel-container' },
          // Main screenshot image wrapper
          React.createElement('div', { className: 'screenshot-wrapper' },
            React.createElement('img', { 
              src: screenshotSrc,
              className: 'screenshot-image',
              alt: `Screenshot ${carousel.currentIndex + 1}`,
              onClick: (e) => {
                e.stopPropagation();
                this.openScreenshotModal(instance, currentScreenshot);
              },
              onError: (e) => {
                // Fallback to logo on error
                e.target.src = '/images/CloudViPER-Logo.png';
                e.target.title = 'Screenshot failed to load';
              }
            })
          ),
          
          // Controls and metadata below the image
          React.createElement('div', { className: 'screenshot-controls' },
            // Navigation buttons on the left
            React.createElement('div', { className: 'screenshot-nav' },
              carousel.screenshots.length > 1 && [
                React.createElement('button', {
                  key: 'prev',
                  className: 'carousel-btn',
                  onClick: (e) => {
                    e.stopPropagation();
                    this.navigateScreenshot(instance.uuid, 'prev');
                  },
                  title: 'Previous screenshot',
                  disabled: carousel.screenshots.length <= 1
                }, '◀'),
                
                React.createElement('button', {
                  key: 'next', 
                  className: 'carousel-btn',
                  onClick: (e) => {
                    e.stopPropagation();
                    this.navigateScreenshot(instance.uuid, 'next');
                  },
                  title: 'Next screenshot',
                  disabled: carousel.screenshots.length <= 1
                }, '▶')
              ]
            ),
            
            // Metadata on the right
            React.createElement('div', { className: 'screenshot-info' },
              carousel.screenshots.length > 1 && React.createElement('span', { className: 'screenshot-counter' },
                `${carousel.currentIndex + 1} of ${carousel.screenshots.length}`
              ),
              React.createElement('span', { className: 'screenshot-badge' },
                `${carousel.uniqueCount} unique`
              ),
              React.createElement('span', { className: 'screenshot-timestamp' },
                timestamp
              )
            )
          )
        );
      }
      renderActivityChart = (instance) => {
        const canvasId = `chart-${instance.uuid}`;
        const { initializedCharts } = this.state;
        
        // Check if this chart has been initialized
        if (!initializedCharts[instance.uuid]) {
          // Show placeholder with "Load Chart" button
          return React.createElement('div', { className: 'activity-chart-container text-center' },
            React.createElement('h6', { className: 'chart-title mb-2', style: { fontSize: '12px' } }, 'Recent Activity'),
            React.createElement('div', { 
              className: 'chart-placeholder',
              style: { 
                width: '180px', 
                height: '100px', 
                display: 'flex', 
                alignItems: 'center', 
                justifyContent: 'center',
                border: '1px solid #dee2e6',
                borderRadius: '4px',
                backgroundColor: '#f8f9fa'
              }
            },
              React.createElement('button', {
                className: 'btn btn-sm btn-outline-primary',
                onClick: () => this.loadActivityChart(canvasId, instance.uuid),
                style: { fontSize: '11px' }
              }, 'Load Activity Chart')
            )
          );
        }
        
        // Chart is initialized, render the canvas
        return React.createElement('div', { className: 'activity-chart-container' },
          React.createElement('h6', { className: 'chart-title text-center mb-2', style: { fontSize: '12px' } }, 'Recent Activity'),
          React.createElement('canvas', { 
            id: canvasId,
            width: 180,
            height: 100,
            style: { width: '100%', height: 'auto', maxWidth: '180px', border: '1px solid #dee2e6', borderRadius: '4px' }
          }),
          React.createElement('div', { className: 'chart-legend mt-1', style: { fontSize: '10px' } },
            React.createElement('span', { style: { color: '#dc3545' } }, '■ CPU '),
            React.createElement('span', { style: { color: '#007bff' } }, '■ RAM '),
            React.createElement('span', { style: { color: '#28a745' } }, '● Activity')
          )
        );
      }
      
      loadActivityChart = (canvasId, instanceUUID) => {
        // Mark this chart as initialized
        this.setState(prevState => ({
          initializedCharts: {
            ...prevState.initializedCharts,
            [instanceUUID]: true
          }
        }), () => {
          // Initialize chart after state update and DOM render
          setTimeout(() => this.initializeChart(canvasId, instanceUUID), 100);
        });
      }

      initializeChart = async (canvasId, instanceUUID) => {
        const activityData = await this.fetchActivityDataForChart(instanceUUID);
        
        if (activityData.length === 0) {
          // Draw "No Data" message
          const canvas = document.getElementById(canvasId);
          if (!canvas) return;
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#f8f9fa';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#6c757d';
          ctx.font = '12px Arial';
          ctx.textAlign = 'center';
          ctx.fillText('No Activity Data', canvas.width / 2, canvas.height / 2);
          return;
        }

        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        
        const ctx = canvas.getContext('2d');
        
        // Prepare data
        const cpuData = activityData.map(d => parseFloat(d.cpuUsage) || 0);
        const memoryData = activityData.map(d => parseFloat(d.memoryUsage) || 0);
        const activityScores = activityData.map(d => d.activityScore || 0);
        
        // Chart dimensions
        const width = canvas.width;
        const height = canvas.height;
        const padding = 15;
        const chartWidth = width - 2 * padding;
        const chartHeight = height - 2 * padding;
        
        // Clear canvas
        ctx.clearRect(0, 0, width, height);
        
        // Draw background
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, width, height);
        
        // Draw grid lines
        ctx.strokeStyle = '#f1f3f4';
        ctx.lineWidth = 0.5;
        for (let i = 1; i < 4; i++) {
          const y = padding + (i * chartHeight / 4);
          ctx.beginPath();
          ctx.moveTo(padding, y);
          ctx.lineTo(padding + chartWidth, y);
          ctx.stroke();
        }
        
        if (activityData.length > 1) {
          const maxCpu = Math.max(...cpuData, 20); // Minimum scale of 20%
          const maxMemory = Math.max(...memoryData, 20);
          const maxActivity = Math.max(...activityScores, 5); // Minimum scale of 5
          
          // Draw CPU line (red)
          ctx.strokeStyle = '#dc3545';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          cpuData.forEach((value, index) => {
            const x = padding + (index / (cpuData.length - 1)) * chartWidth;
            const y = padding + chartHeight - (value / maxCpu) * chartHeight;
            if (index === 0) {
              ctx.moveTo(x, y);
            } else {
              ctx.lineTo(x, y);
            }
          });
          ctx.stroke();
          
          // Draw Memory line (blue)
          ctx.strokeStyle = '#007bff';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          memoryData.forEach((value, index) => {
            const x = padding + (index / (memoryData.length - 1)) * chartWidth;
            const y = padding + chartHeight - (value / maxMemory) * chartHeight;
            if (index === 0) {
              ctx.moveTo(x, y);
            } else {
              ctx.lineTo(x, y);
            }
          });
          ctx.stroke();
          
          // Draw Activity dots (green) - only when activity > 0
          ctx.fillStyle = '#28a745';
          activityScores.forEach((value, index) => {
            if (value > 0) {
              const x = padding + (index / (activityScores.length - 1)) * chartWidth;
              const y = padding + chartHeight - (value / maxActivity) * chartHeight;
              ctx.beginPath();
              ctx.arc(x, y, 2, 0, 2 * Math.PI);
              ctx.fill();
            }
          });
        }
        
        // Draw border
        ctx.strokeStyle = '#dee2e6';
        ctx.lineWidth = 1;
        ctx.strokeRect(0, 0, width, height);
      }

      viewScreenshot = async (instanceUUID) => {
        try {
          const response = await fetch(`/service/screenshot/${instanceUUID}`);
          const data = await response.json();
          
          if (data.success && data.screenshot) {
            // Create a modal or new window to display the screenshot
            const screenshotWindow = window.open('', '_blank', 'width=800,height=600');
            screenshotWindow.document.write(`
              <html>
                <head><title>Screenshot - ${instanceUUID}</title></head>
                <body style="margin:0;padding:20px;background:#f0f0f0;">
                  <h3>Instance Screenshot</h3>
                  <p><strong>Instance:</strong> ${instanceUUID}</p>
                  <p><strong>Captured:</strong> ${data.screenshot.capturedAt ? new Date(data.screenshot.capturedAt).toLocaleString() : 'Unknown'}</p>
                  <img src="data:image/png;base64,${data.screenshot.screenshot}" style="max-width:100%;border:1px solid #ccc;" />
                </body>
              </html>
            `);
          } else {
            alert('No screenshot available for this instance');
          }
        } catch (error) {
          console.error('Error fetching screenshot:', error);
          alert('Error fetching screenshot');
        }
      }

      cleanupInactiveInstances = async () => {
        if (!confirm('This will automatically shutdown instances that have been inactive for 30+ minutes. Continue?')) {
          return;
        }

        try {
          const response = await fetch('/service/cleanup-inactive', { method: 'POST' });
          const data = await response.json();
          
          if (data.success) {
            alert(`Cleanup completed: ${data.shutdownCount} instances shut down`);
            this.fetchInstances(); // Refresh the list
          } else {
            alert('Error during cleanup: ' + data.error);
          }
        } catch (error) {
          console.error('Error during cleanup:', error);
          alert('Error during cleanup');
        }
      }

      render() {
        const { instances, isLoading, error, selectedInstance, instanceDetails, detailsLoading, filters, showFilters, screenshotModal, creatingInstance, deletingInstances, connectionLost, connectionRestored } = this.state;
        const filteredInstances = this.getFilteredInstances();

        // Only show loading on initial load (when we have no instances yet)
        if (isLoading && instances.length === 0) {
          return <p>Loading instances...</p>;
        }

        // Don't show error if we have existing data - show banner instead

        return (
          <div>
            <h1>ViPER Instances</h1>
            
            {/* Filter Controls */}
            {/* Connection Status Banners */}
            {connectionLost && React.createElement('div', {
              className: 'alert alert-danger connection-banner',
              role: 'alert',
              style: { position: 'fixed', top: '70px', right: '20px', zIndex: 1040, minWidth: '350px', boxShadow: '0 4px 6px rgba(0,0,0,0.1)' }
            }, [
              React.createElement('i', { className: 'fas fa-exclamation-triangle', key: 'icon' }),
              ' Connection to API lost - retrying automatically...'
            ])}
            
            {connectionRestored && React.createElement('div', {
              className: 'alert alert-success connection-banner',
              role: 'alert',
              style: { position: 'fixed', top: '70px', right: '20px', zIndex: 1040, minWidth: '350px', boxShadow: '0 4px 6px rgba(0,0,0,0.1)' }
            }, [
              React.createElement('i', { className: 'fas fa-check-circle', key: 'icon' }),
              ' Connection restored!'
            ])}

            <div className="filter-controls mb-3">
              <button 
                className="btn btn-outline-secondary btn-sm" 
                onClick={this.toggleFiltersPanel}
              >
                <i className="fas fa-filter"></i> {showFilters ? 'Hide' : 'Show'} Filters
              </button>
              
              {showFilters && (
                <div className="filter-panel mt-2 p-3 border rounded bg-light">
                  <div className="row">
                    <div className="col-md-8">
                      <h6>Filter by Instance Status:</h6>
                      <div className="filter-checkboxes">
                        {Object.entries(filters).map(([status, checked]) => (
                          <label key={status} className="filter-checkbox">
                            <input
                              type="checkbox"
                              checked={checked}
                              onChange={() => this.toggleFilter(status)}
                            />
                            <span className={'status-badge status-' + status + ' ml-1'}>
                              {status.charAt(0).toUpperCase() + status.slice(1)}
                            </span>
                          </label>
                        ))}
                      </div>
                    </div>
                    <div className="col-md-4">
                      <h6>Quick Actions:</h6>
                      <button 
                        className="btn btn-sm btn-success mr-2" 
                        onClick={this.selectAllFilters}
                      >
                        Select All
                      </button>
                      <button 
                        className="btn btn-sm btn-danger" 
                        onClick={this.clearAllFilters}
                      >
                        Clear All
                      </button>
                      <div className="mt-2">
                        <small className="text-muted">
                          Showing {filteredInstances.length} of {instances.length} instances
                        </small>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>

            <div className="btn-container">
              <button 
                className={'btn btn-primary ' + (creatingInstance ? 'disabled' : '')} 
                onClick={this.startNewInstance}
                disabled={creatingInstance}
              >
                {creatingInstance ? (
                  <span>
                    <i className="fas fa-spinner fa-spin"></i> Creating Instance...
                  </span>
                ) : (
                  <span>
                    <i className="fas fa-plus"></i> Start New Instance
                  </span>
                )}
              </button>
            </div>

            {/* Instance Details Modal */}
            {selectedInstance && (
              <div className="instance-details-overlay" onClick={this.closeDetailsPanel}>
                <div className="instance-details-modal" onClick={(e) => e.stopPropagation()}>
                  <div className="modal-header">
                    <h3>Instance Details: {selectedInstance.name}</h3>
                    <button className="btn btn-sm btn-secondary" onClick={this.closeDetailsPanel}>
                      <i className="fas fa-times"></i>
                    </button>
                  </div>
                  
                  {detailsLoading ? (
                    <div className="modal-body">
                      <p>Loading detailed information...</p>
                    </div>
                  ) : instanceDetails ? (
                    <div className="modal-body">
                      {instanceDetails.error ? (
                        <div className="error-message">
                          <p><strong>Error:</strong> {instanceDetails.error}</p>
                          <p>Showing basic instance information only.</p>
                        </div>
                      ) : null}
                      
                      {/* Human-readable metadata */}
                      <div className="details-section">
                        <h4><i class="fas fa-chart-line"></i> Instance Metadata</h4>
                        <div className="metadata-grid">
                          <div><strong>Operational Time:</strong> {instanceDetails.operationalHours || 'Unknown'} hours</div>
                          <div><strong>Owner:</strong> {this.formatOwnerInfo(instanceDetails.instance)}</div>
                          <div><strong>Status:</strong> 
                            {instanceDetails.instance && instanceDetails.instance.status ? (
                              <span className={'status-badge status-' + instanceDetails.instance.status}>
                                {instanceDetails.instance.status}
                              </span>
                            ) : (
                              'Unknown'
                            )}
                          </div>
                          <div><strong>Pod Name:</strong> <code>{instanceDetails.instance && instanceDetails.instance.podName || 'Unknown'}</code></div>
                          <div><strong>UUID:</strong> <code>{instanceDetails.instance && instanceDetails.instance.uuid || 'Unknown'}</code></div>
                          <div><strong>Created:</strong> 
                            {instanceDetails.instance && instanceDetails.instance.createdAt ? 
                              new Date(instanceDetails.instance.createdAt).toLocaleString() : 
                              'Unknown'
                            }
                          </div>
                          <div><strong>VNC Password:</strong> <code>{instanceDetails.instance && instanceDetails.instance.kasmvncPassword || 'Unknown'}</code></div>
                          <div><strong>URL:</strong> 
                            {instanceDetails.instance && instanceDetails.instance.url ? (
                              instanceDetails.instance.status === 'active' ? (
                                <a href={this.formatUrl(instanceDetails.instance.url)} target="_blank" rel="noopener noreferrer">
                                  {instanceDetails.instance.url}
                                </a>
                              ) : (
                                instanceDetails.instance.url
                              )
                            ) : (
                              'Unknown'
                            )}
                          </div>
                        </div>
                      </div>

                      {/* Pod Inspect Data */}
                      <div className="details-section">
                        <h4>☸️ Pod Inspect Data</h4>
                        {instanceDetails.podInspect && instanceDetails.podInspect.error ? (
                          <div className="error-message">
                            <p><strong>Error:</strong> {instanceDetails.podInspect.error}</p>
                            <p>{instanceDetails.podInspect.message}</p>
                          </div>
                        ) : instanceDetails.podInspect ? (
                          <div className="docker-inspect-container">
                            <pre className="docker-inspect-json">
                              {JSON.stringify(instanceDetails.podInspect, null, 2)}
                            </pre>
                          </div>
                        ) : (
                          <div className="error-message">
                            <p><strong>No pod data available</strong></p>
                            <p>Pod inspect information could not be retrieved.</p>
                          </div>
                        )}
                      </div>
                    </div>
                  ) : (
                    <div className="modal-body">
                      <p>Error loading instance details.</p>
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* Screenshot Modal */}
            {screenshotModal.isOpen && (
              <div className="screenshot-modal-overlay" onClick={this.closeScreenshotModal}>
                <div className="screenshot-modal-content" onClick={(e) => e.stopPropagation()}>
                  <div className="screenshot-modal-header">
                    <h5 className="modal-title">{screenshotModal.title}</h5>
                    <button className="screenshot-modal-close" onClick={this.closeScreenshotModal}>
                      ×
                    </button>
                  </div>
                  <div className="screenshot-modal-body">
                    <img 
                      src={screenshotModal.imageUrl}
                      className="screenshot-modal-image"
                      alt="Screenshot"
                      onError={(e) => {
                        e.target.src = '/images/CloudViPER-Logo.png';
                      }}
                    />
                  </div>
                </div>
              </div>
            )}

            <table className="table table-striped">
              <thead>
                <tr>
                    <th>ViPERs:</th>
                </tr>
              </thead>
              <tbody>
                {Array.isArray(filteredInstances) && filteredInstances.map(instance => (
                  <tr key={instance.uuid}><td>

                        {{!-- <row> --}}
                        <div className="card mb-3">
                        <div className="row">
                            <div className="col-md-5 center-image">
                              {/* Dynamic Screenshot Carousel */}
                              {this.renderScreenshotCarousel(instance)}
                            </div>
                            <div className="col-md-4">
                            <div className="card-body">
                                <h5 className="card-title">{instance.name}</h5>
                                <h6 className="card-subtitle mb-2 text-muted">{instance.dockerid}</h6>
                                <p className="card-text">
                                <small className="text-muted">
                                  <span className={'status-badge status-' + instance.status}>
                                    {instance.status}
                                  </span>
                                </small><br/>
                                <small className="text-muted"><strong>UUID: </strong>{instance.uuid}</small><br/>
                  <small className="text-muted">
                    <strong>URL: </strong>
                    {instance.status === 'ready' ? (
                      <a href={this.formatUrl(instance.url)} target="_blank" rel="noopener noreferrer">{instance.url}</a>
                    ) : (
                      instance.url
                    )}
                  </small><br/>
                                <small className="text-muted"><strong>Username: </strong>abc</small><br/>
                                <small className="text-muted"><strong>Password: </strong>{instance.kasmvncPassword}</small><br/>
                                <small className="text-muted"><strong>Created At: </strong>{new Date(instance.createdAt).toLocaleString()}</small><br/>
                                <small className="text-muted"><strong>Owner: </strong>{this.formatOwnerInfo(instance)}</small><br/>
                                {instance.lastActivity && (
                                  <small className="text-muted"><strong>Last Activity: </strong>{new Date(instance.lastActivity).toLocaleString()}</small>
                                )}<br/>
                                {instance.isUserActive !== undefined && (
                                  <small className="text-muted">
                                    <strong>Status: </strong>
                                    <span className={instance.isUserActive ? 'text-success' : 'text-warning'}>
                                      {instance.isUserActive ? '🟢 Active User' : '🟡 Inactive'}
                                    </span>
                                  </small>
                                )}<br/>
                                {instance.activityScore !== undefined && (
                                  <small className="text-muted"><strong>Activity Score: </strong>{instance.activityScore}</small>
                                )}
                                </p>
                            </div>
                            </div>
                            <div className="col-md-3 d-flex flex-column justify-content-center align-items-center">
                              {/* Activity Chart */}
                              {this.renderActivityChart(instance)}
                            </div>
                        </div>
                        
                        {/* Buttons Row */}
                        <div className="row">
                          <div className="col-12">
                            <div className="card-footer">
                              <div className="instance-buttons">
                                <button
                                  className={'btn btn-primary ' + (instance.status === 'ready' ? '' : 'disabled')} 
                                  onClick={() => window.open(this.formatUrl(instance.url), '_blank')}
                                  disabled={instance.status !== 'ready'}
                                  title={instance.status !== 'ready' ? 'Instance is ' + instance.status : 'Launch ViPER Instance'}
                                >
                                  <i className="fas fa-external-link-alt"></i> Launch Instance
                                </button>
                                {this.isAdmin() && (
                                  <button 
                                    className="btn btn-info" 
                                    onClick={() => this.showInstanceDetails(instance)}
                                  >
                                    <i className="fas fa-info-circle"></i> Details
                                  </button>
                                )}
                                {this.isAdmin() && (
                                  <button 
                                    className="btn btn-success btn-sm" 
                                    onClick={() => this.loadActivityHistory(instance.uuid)}
                                  >
                                    <i className="fas fa-chart-line"></i> Activity
                                  </button>
                                )}
                                {this.isAdmin() && instance.lastScreenshot && (
                                  <button 
                                    className="btn btn-secondary btn-sm" 
                                    onClick={() => this.viewScreenshot(instance.uuid)}
                                  >
                                    <i className="fas fa-camera"></i> Screenshot
                                  </button>
                                )}
                                <button 
                                  className={'btn btn-danger ' + (instance.status === 'deleted' || deletingInstances[instance.podName] ? 'disabled' : '')} 
                                  onClick={() => this.removeInstance(instance.podName)} 
                                  disabled={instance.status === 'deleted' || deletingInstances[instance.podName]}
                                >
                                  {deletingInstances[instance.podName] ? (
                                    <span>
                                      <i className="fas fa-spinner fa-spin"></i> Removing...
                                    </span>
                                  ) : (
                                    <span>
                                      <i className="fas fa-trash"></i> Remove Instance
                                    </span>
                                  )}
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                        </div>
                    {{!-- </row> --}}

                  </td></tr>
                ))}
              </tbody>
            </table>

            {/* Admin Cleanup Controls */}
            {this.isAdmin() && (
              <div className="alert alert-warning mt-4">
                <h5><i className="fas fa-tools"></i> Admin Controls</h5>
                <p>Use these controls to manage inactive instances automatically.</p>
                <button 
                  className="btn btn-warning"
                  onClick={this.cleanupInactiveInstances}
                >
                  <i className="fas fa-broom"></i> Cleanup Inactive Instances
                </button>
                <small className="form-text text-muted mt-2">
                  This will automatically shutdown instances that have been inactive for 30+ minutes.
                </small>
              </div>
            )}
          </div>
        );
      }
    }