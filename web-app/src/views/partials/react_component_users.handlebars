class UserList extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      users: [],
      isLoading: true,
      error: null,
      newUserEmail: '',
      newUserRole: 'user',
    };
  }

  componentDidMount() {
    fetch('/account/users')
      .then((response) => response.json())
      .then((data) => this.setState({ users: data, isLoading: false }))
      .catch((error) => this.setState({ error, isLoading: false }));
  }

  handleRoleChange = (userId, newRole) => {
    fetch(`/account/users/${userId}/role`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ role: newRole }),
    })
      .then((response) => response.json())
      .then((data) => {
        console.log('Invite user response:', data);
        this.setState({ newUserEmail: '', newUserRole: 'user' });
        this.fetchUsers();
      })
      .catch((error) => {
        console.error('Error updating role:', error);
      });
  };


  fetchUsers = () => {
    this.setState({ isLoading: true });
    fetch('/account/users')
      .then((response) => response.json())
      .then((data) => this.setState({ users: data, isLoading: false }))
      .catch((error) => this.setState({ error, isLoading: false }));
  };
  
  handleInviteUser = () => {
    const { newUserEmail, newUserRole } = this.state;
    fetch('/account/users/invite', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ email: newUserEmail, role: newUserRole }),
    })
      .then((response) => response.json())
      .then((data) => {
        this.setState((prevState) => ({
          newUserEmail: '',
          newUserRole: 'user',
        }));
        this.fetchUsers();
      })
      .catch((error) => {
        console.error('Error inviting user:', error);
      });
  };

  render() {
    const { users, isLoading, error, newUserEmail, newUserRole } = this.state;

    if (isLoading) {
      return <p>Loading users...</p>;
    }

    if (error) {
      return <p>Error loading users: {error.message}</p>;
    }

    return (
      <div>
        <h2>User List</h2>
        <table className="table table-striped">
          <thead>
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
              <th>OAuth Provider</th>
              <th>Created At</th>
              <th>Updated At</th>
            </tr>
          </thead>
          <tbody>
            {users.map((user) => (
              <tr key={user.id}>
                <td>{user.id}</td>
                <td>{user.username}</td>
                <td>{user.email}</td>
                <td>
                  <select
                    className="form-control"
                    value={user.role}
                    onChange={(e) => this.handleRoleChange(user.id, e.target.value)}
                  >
                    <option value="user">User</option>
                    <option value="testing">Testing</option>
                    <option value="member">Member</option>
                    <option value="admin">Admin</option>
                  </select>
                </td>
                <td>{user.oauthProvider}</td>
                <td>{new Date(user.createdAt).toLocaleString()}</td>
                <td>{new Date(user.updatedAt).toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <h2>Invite User</h2>
        <form
          className="form-inviteuser"
          onSubmit={(e) => {
            e.preventDefault();
            this.handleInviteUser();
          }}
        >
          <div className="form-group">
            <label>Email:</label>
            <input
              type="email"
              className="form-control"
              value={newUserEmail}
              onChange={(e) => this.setState({ newUserEmail: e.target.value })}
              required
            />
          </div>
          <div className="form-group">
            <label>Role:</label>
            <select
              className="form-control"
              value={newUserRole}
              onChange={(e) => this.setState({ newUserRole: e.target.value })}
              required
            >
              <option value="user">User</option>
              <option value="testing">Testing</option>
              <option value="member">Member</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <button type="submit" className="btn btn-primary">Invite</button>
        </form>
      </div>
    );
  }
}