# Example environment variables for ViPERCloud Web App

# Replace the placeholders (e.g., [[STRONG_COMPLEX_PASSWORD]], [[DATABASE_NAME]], etc.) with your actual configuration values.
#Database
MYSQL_ROOT_PASSWORD=[[STRONG_COMPLEX_PASSWORD]]
MYSQL_DATABASE=[[DATABASE_NAME]]
MYSQL_USER=[[DATABASE_USER]]
MYSQL_PASSWORD=[[STRONG_COMPLEX_PASSWORD]]

DB_HOST=[[DATABASE_HOST]]
DB_PORT=3306
DB_USER=[[DATABASE_USER]]
DB_PASSWORD=[[STRONG_COMPLEX_PASSWORD]]
DB_NAME=[[DATABASE_NAME]]

# Email Configuration
# Choose email provider: 'mailersend' or 'resend'
EMAIL_PROVIDER=mailersend
MAILERSEND_API_KEY=[[YOUR_MAILERSEND_API_KEY]]
RESEND_API_KEY=[[YOUR_RESEND_API_KEY]]
# Optional: Use a different domain for sending emails (e.g., updates.yourdomain.com)
EMAIL_SEND_DOMAIN=[[YOUR_EMAIL_SEND_DOMAIN]]

#Google OAuth Configuration
GOOGLE_AUTH_CLIENT_ID=[[YOUR_CLIENT_ID]]
GOOGLE_AUTH_CLIENT_SECRET=[[YOUR_CLIENT_SECRET]]

#Application Settings
PORT=3000
APP_COOKIE_SECRET=[[YOUR_APP_COOKIE_SECRET]]
APP_HOST=[[HOSTNAME]]
DOMAIN_NAME=[[YOUR_DOMAIN]]

NODE_ENV=dev
