{
    "compilerOptions": {
      "target": "ES6",
      "module": "commonjs",
      "outDir": "./dist",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "typeRoots": ["./node_modules/@types", "./typings"],
      "forceConsistentCasingInFileNames": true,
      "inlineSources": true,
      "sourceMap": true,
    },
    "include": ["src/**/*"]
}