[mysqld]
# Basic Settings
default_authentication_plugin = mysql_native_password
skip-log-bin

# Performance Schema - Disable for memory savings
performance_schema = OFF

# Connection Settings
max_connections = 50
connect_timeout = 10
wait_timeout = 600

# Memory Settings - Optimized for 8GB RAM server
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
innodb_sort_buffer_size = 256K

# MyISAM Settings
key_buffer_size = 8M
myisam_sort_buffer_size = 512K

# Table Cache
table_open_cache = 400
table_definition_cache = 400

# Thread Settings
thread_cache_size = 8
thread_stack = 256K

# Temp Tables
tmp_table_size = 16M
max_heap_table_size = 16M

# Per-Connection Buffers (keep small)
sort_buffer_size = 128K
read_buffer_size = 128K
read_rnd_buffer_size = 128K
join_buffer_size = 128K

# InnoDB Settings
innodb_flush_method = O_DIRECT
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1
innodb_buffer_pool_instances = 1

# Logging
slow_query_log = 0
general_log = 0
log_error_verbosity = 2

# Binary Logging (using seconds instead of deprecated expire_logs_days)
binlog_expire_logs_seconds = 259200

# Character Set
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci
