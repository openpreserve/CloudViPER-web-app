apiVersion: v1
kind: Secret
metadata:
  name: viper-app-secret
  labels:
    app: viper-app
type: Opaque
data:
  # MySQL credentials (base64 encoded)
  MYSQL_ROOT_PASSWORD: <base64-encoded-password>
  MYSQL_PASSWORD: <base64-encoded-password>
  DB_PASSWORD: <base64-encoded-password>
  
  # Email service API keys (base64 encoded)
  SENDGRID_API_KEY: <base64-encoded-key>
  MAILERSEND_API_KEY: <base64-encoded-key>
  
  # Google OAuth credentials (base64 encoded)
  GOOGLE_AUTH_CLIENT_ID: <base64-encoded-client-id>
  GOOGLE_AUTH_CLIENT_SECRET: <base64-encoded-client-secret>
  
  # Application cookie secret (base64 encoded)
  APP_COOKIE_SECRET: <base64-encoded-secret>
  
  # Initial admin credentials (created on first run if no admin exists)
  INITIAL_ADMIN_USERNAME: YWRtaW4=  # admin
  INITIAL_ADMIN_EMAIL: YWRtaW5AZXhhbXBsZS5jb20=  # admin@example.com
  INITIAL_ADMIN_PASSWORD: Q2hhbmdlTWVPbkZpcnN0TG9naW4xMjMh  # ChangeMe OnFirstLogin123!
  
# To encode values: echo -n 'your-value' | base64
# To decode values: echo 'base64-string' | base64 -d
