    <div class="text-white">
        <h1>{{{form_h1}}}</h1>
        <p>{{{form_p}}}</p>
    </div>

    {{#if error_message}}
            {{#ifNotEquals error_message ""}}
            <div class="alert alert-danger" role="alert">
                {{error_message}}
            </div>
            {{/ifNotEquals}}
    {{/if}}

    <div>
    <form method="post" action="/account/login" class="nps-form">
        <div class="mb-3">
            <label for="username" class="form-label text-white">Username:</label>
            <input type="text" id="username" name="username" placeholder="Username" required>

            <label for="password" class="form-label text-white">Password:</label>
            <input type="password" id="password" name="password" placeholder="Password" required>
        </div>
        <div class="mb-3">
            <input class="btn btn-secondary" style="width:100%" type="submit" value="Login">
        </div>
    </form>

    <a href="/account/login/google" class="btn btn-block google-btn">
        <img src="https://img.icons8.com/color/16/000000/google-logo.png"/> Login with Google
    </a>
    <hr> 
    <p class="text-white">The admin section of the website uses functional cookies.</p>
    <div><a href="/account/register">Register New Account</a> - <a href="/account/forgotpassword">Forgot Password?</a></div>
    </div>
