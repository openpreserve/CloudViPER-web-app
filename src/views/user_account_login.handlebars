    <div class="text-white">
        <h1>{{{form_h1}}}</h1>
        <p>{{{form_p}}}</p>
    </div>

    {{#if error_message}}
            {{#ifNotEquals error_message ""}}
            <div class="alert alert-danger" role="alert">
                <p>{{error_message}}</p>
                <p>Login Failed!</p>
            </div>
            {{/ifNotEquals}}
    {{/if}}


    <div class="container">
        <div class="row">
            <div class="col-md-4">
            <form method="post" action="/account/login" class="nps-form">
                <div class="mb-3">
                    <label for="username" class="form-label text-white">Username:</label>
                    <input type="text" id="username" name="username" placeholder="Username" required>

                    <label for="password" class="form-label text-white">Password:</label>
                    <input type="password" id="password" name="password" placeholder="Password" required>
                </div>
                <div class="mb-3">
                    <input class="btn btn-secondary" style="width:100%" type="submit" value="Login">
                </div>
            </form>

            <a href="/account/login/google" class="btn btn-block google-btn">
                <img src="https://img.icons8.com/color/16/000000/google-logo.png"/> Login with Google
            </a>
            <hr> 
            <p class="text-white">The admin section of the website uses functional cookies.</p>
            <div><a href="/account/register">Register New Account</a> - <a href="/account/reset-password">Forgot Password?</a></div>
            </div>
            <div class="col-md-8">
                <h2>ViPER Cloud</h2>
                <p>Welcome to our app! Here, we prioritize your privacy and security above all. Feel free to log in and explore our features. Remember, we never share your information with anyone.</p>
                <p>If you encounter any issues while logging in, please contact our support team for assistance. We're here to help you every step of the way.</p>
            </div>
        </div>
    </div>