            <div class="text-white">
                <h1>member Account</h1>
                <p>{{{form_p}}}</p>
            </div>

            <div style="background:#fff">
                <div>
                    <input id="btn-new-viper" class="btn btn-secondary" value="Start New Viper Instance">
                </div>
                <div><h2>Your Containers:</h2></div>
                <div id="containers-div">
                    
                </div>
            </div>

            <script>
                $(document).ready(function() {
                    $('#btn-new-viper').click(function() {
                        $.get('/service/new-instance', function(data) {
                            // Assuming data is a JSON object
                            $('#containers-div').append('<div><pre>' + JSON.stringify(data, null, 2) + '</pre><div><a target="_BLANK" href="https://'+data.container.url+'">'+data.container.url+'<a/>&nbsp;-&nbsp;<a target="_BLANK" href="/admin/terminate-instance/'+data.container.id+'">Terminate Container<a/></div></div>');
                        }).fail(function() {
                            $('#containers-div').text('Error fetching data.');
                        });
                    });
                });

            </script>