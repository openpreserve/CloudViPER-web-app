            <div class="text-white">
                <h1>Register new Account</h1>
                <p>By signing up for a new account you are accepting the terms and conditions</p>
                <p>{{{form_p}}}</p>
            </div>
            <div>
            <form method="post" action="/account/register" class="nps-form">
                <div class="mb-3">
                    <div>
                        <label for="username" class="form-label text-white">Username:</label>
                        <input type="text" id="username" name="username" placeholder="Username" required>
                    </div>

                    <div>              
                        <label for="password" class="form-label text-white">Password:</label>
                        <input type="password" id="password" name="password" placeholder="Password" required>
                    </div>
                    <div>
                        <label for="email" class="form-label text-white">Email:</label>
                        <input type="text" id="email" name="email" placeholder="email" required>
                    </div>

                </div>
                <div class="mb-3">
                    <input class="btn btn-secondary" style="width:100%" type="submit" value="Submit">
                </div>
            </form>
            <p class="text-white">The admin section of the website uses functional cookies.</p>
            </div>
